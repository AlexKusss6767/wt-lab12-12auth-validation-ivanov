@page
@model wt_lab8_8razor_postgresql_ivanov.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold"><i class="bi bi-box-seam text-primary"></i> Каталог товаров</h1>
            <p class="text-muted">Данные из PostgreSQL</p>
        </div>
        <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Добавить товар</a>
    </div>

    <!-- Форма поиска -->
    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Введите название товара...">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Найти</button>
        </div>
    </form>

    <div class="row g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4 border-0">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">ID: @product.Id</span>
                        <h5 class="card-title fw-bold">@product.Name</h5>
                        <p class="card-text text-muted small"><i class="bi bi-tag"></i> @product.Category</p>
                        <p class="fs-4 fw-bold text-primary mb-2">@product.Price ₽</p>
                        
                        @if (product.IsAvailable)
                        {
                            <span class="badge bg-success mb-3 align-self-start"><i class="bi bi-check-circle"></i> В наличии</span>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-3 align-self-start"><i class="bi bi-x-circle"></i> Нет в наличии</span>
                        }
                        
                        <div class="mt-auto d-flex gap-2">
                            <a asp-page="Details" asp-route-id="@product.Id" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-eye"></i> Подробнее</a>
                            <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>